# ── Database (supports DATABASE_URL, DB_DSN, or individual DB_* variables) ──
DATABASE_URL=postgres://postgres:parth%20grey1@localhost:5432/ecom_db?sslmode=disable
DB_DSN=postgres://postgres:parth%20grey1@localhost:5432/ecom_db?sslmode=disable
DB_USER=postgres
DB_PASSWORD=parth grey1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecom_db

# ── Server ─────────────────────────────────────────
PORT=8080
ENV=development

# ── JWT ────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-32-byte-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ── CORS ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1

# ── Shipping ───────────────────────────────────────
SHIPPING_FLAT_RATE=500

# ── Buyers Premium (percentage, integer) ───────────
BUYERS_PREMIUM_PCT=10

# ── Khalti Payment ─────────────────────────────────
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_BASE_URL=https://a.khalti.com/api/v2

# ── Uploads ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ── GA4 (optional, disabled when empty) ────────────
GA4_MEASUREMENT_ID=
